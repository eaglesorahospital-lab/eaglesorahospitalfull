# ==============================================================================
# Environment Configuration Template (Phase 17 — Production Deployment)
# Copy this file to .env for local environment configuration.
# Do NOT commit actual credentials or production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx
DJANGO_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# PostgreSQL Database (Phase 24 — Neon PostgreSQL Free or Local Docker)
# ------------------------------------------------------------------------------
# In hosted environments (e.g. Neon Serverless PostgreSQL), set DATABASE_URL:
# Example: postgres://<user>:<password>@<ep-endpoint>.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
DJANGO_DB_SSL_REQUIRE=True
# Optional connection max age in seconds (0 recommended for PgBouncer / Neon connection pooler):
DJANGO_DB_CONN_MAX_AGE=0

# For local Docker / discrete variable configuration:
POSTGRES_DB=hospital_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Aliases for container/test compatibility
DB_NAME=hospital_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# ------------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS) & CSRF
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# ------------------------------------------------------------------------------
# Redis Cache & Distributed Rate Limiting (Phase 24/25 — Upstash Redis Free)
# ------------------------------------------------------------------------------
# For hosted environments (e.g. Render with Upstash Redis Free), set REDIS_URL to the
# TLS-enabled connection string provided by Upstash:
# Format: rediss://default:<password>@<endpoint>.upstash.io:6379
#
# For local Docker development:
REDIS_URL=redis://redis:6379/1
REDIS_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5
# In production (DEBUG=False) without a Redis instance, setting this to True permits
# single-instance in-memory LocMemCache with reduced per-process rate-limiting guarantees:
ALLOW_IN_MEMORY_CACHE_FALLBACK=False

# ------------------------------------------------------------------------------
# Celery Asynchronous & Demo Processing (Phase 24 — Synchronous Demo Mode)
# ------------------------------------------------------------------------------
# In Phase 24 approved demo mode, CELERY_TASK_ALWAYS_EAGER=True runs immediate notification
# tasks (confirmation, cancellation, reschedule) in-process without requiring a remote worker.
# Broker defaults to memory:// to protect Upstash Redis free command limits.
# Note: Automated 24-hour scheduled reminders remain inactive without Celery Beat.
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=False
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ------------------------------------------------------------------------------
# JWT / SimpleJWT Token Lifetimes
# ------------------------------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ------------------------------------------------------------------------------
# Gunicorn WSGI Server Settings
# ------------------------------------------------------------------------------
PORT=8000
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=5
REST_FRAMEWORK_NUM_PROXIES=1

# ------------------------------------------------------------------------------
# HTTPS / SSL Security Settings (Enable in Production)
# ------------------------------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0

# ------------------------------------------------------------------------------
# Transactional Email / SMTP Service
# ------------------------------------------------------------------------------
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@hospitalplatform.local

# ------------------------------------------------------------------------------
# Cloudinary Persistent Media Storage (Phase 24 — Server-Side Only)
# ------------------------------------------------------------------------------
# Cloudinary Free provides 25 monthly credits shared across storage, transformations,
# and bandwidth. Keep credentials server-side; NEVER expose as VITE_ variables.
# When omitted, system safely falls back to local FileSystemStorage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# Frontend & Nginx Environment
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=60000
NGINX_PORT=80
